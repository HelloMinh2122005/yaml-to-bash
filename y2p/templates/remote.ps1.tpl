# generated by yaml_to_powershell from __JOB_NAME__ (sha256: __JOB_HASH__) — do not edit
$Y2B_RUN_ID = '__RUN_ID__'
$ResFile = __RES_FILE__
$LogFile = __LOG_FILE__

$resDir = [System.IO.Path]::GetDirectoryName($ResFile)
if ($resDir -and -not (Test-Path -LiteralPath $resDir)) {
  [System.IO.Directory]::CreateDirectory($resDir) | Out-Null
}
$logDir = [System.IO.Path]::GetDirectoryName($LogFile)
if ($logDir -and -not (Test-Path -LiteralPath $logDir)) {
  [System.IO.Directory]::CreateDirectory($logDir) | Out-Null
}

$WorkDir = Join-Path $resDir "y2p-$Y2B_RUN_ID"
if (-not (Test-Path -LiteralPath $WorkDir)) {
  [System.IO.Directory]::CreateDirectory($WorkDir) | Out-Null
}

function Add-Y2Line([string]$Path, [string]$Line) {
  [IO.File]::AppendAllText($Path, $Line + "`n", (New-Object Text.UTF8Encoding $false))
}

function ConvertTo-Y2Base64([string]$v) {
  [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($v))
}

[IO.File]::WriteAllText($ResFile, "", (New-Object Text.UTF8Encoding $false))
Add-Y2Line $ResFile ("__Y2B_RUN__=" + (ConvertTo-Y2Base64 $Y2B_RUN_ID))
Add-Y2Line $LogFile "===== $(Get-Date -Format o) run start (job sha256 __JOB_HASH__)"

$env:Y2_RES_FILE = $ResFile
$env:Y2_LOG_FILE = $LogFile

$Prelude = @'
function Add-Y2Line([string]$Path, [string]$Line) {
  [IO.File]::AppendAllText($Path, $Line + "`n", (New-Object Text.UTF8Encoding $false))
}
function write_result {
  if ($args.Count -ne 2 -or $args[0] -cnotmatch '^[A-Z_][A-Z0-9_]*$' -or $args[0].StartsWith('__Y2B_')) {
    Add-Y2Line $env:Y2_LOG_FILE "write_result: expected 'write_result NAME VALUE' with NAME matching ^[A-Z_][A-Z0-9_]*$ (step $env:Y2_STEP_NAME)"
    return
  }
  $v = [string]$args[1]
  Add-Y2Line $env:Y2_RES_FILE ($args[0] + '=' + [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($v)))
  Add-Y2Line $env:Y2_LOG_FILE ($args[0] + '="' + $v + '"')
}
'@

$PsExe = (Get-Process -Id $PID).Path
function Invoke-Y2Step([int]$Index, [string]$Name, [int]$Timeout, [string]$Body) {
  $file = Join-Path $WorkDir "step_$Index.ps1"
  [IO.File]::WriteAllText($file, $Prelude + "`n" + $Body, (New-Object Text.UTF8Encoding $true))
  $env:Y2_STEP_NAME = $Name
  Add-Y2Line $LogFile "=== $(Get-Date -Format o) step $Index $Name"
  $p = Start-Process -FilePath $PsExe -NoNewWindow -PassThru `
         -ArgumentList '-NoProfile','-NonInteractive','-ExecutionPolicy','Bypass','-File',"`"$file`"" `
         -RedirectStandardOutput "$file.out" -RedirectStandardError "$file.err"
  $null = $p.Handle
  if ($p.WaitForExit($Timeout * 1000)) {
    $status = if ($p.ExitCode -eq 0) { 'ok' } else { "rc=$($p.ExitCode)" }
  } else {
    if (Get-Command taskkill.exe -ErrorAction SilentlyContinue) { taskkill.exe /T /F /PID $p.Id | Out-Null } else { $p.Kill() }
    $status = 'timeout'
  }
  if (Test-Path -LiteralPath "$file.out") {
    $outContent = [IO.File]::ReadAllText("$file.out")
    if ($outContent) { [IO.File]::AppendAllText($LogFile, $outContent, (New-Object Text.UTF8Encoding $false)) }
  }
  if (Test-Path -LiteralPath "$file.err") {
    $errContent = [IO.File]::ReadAllText("$file.err")
    if ($errContent) { [IO.File]::AppendAllText($LogFile, $errContent, (New-Object Text.UTF8Encoding $false)) }
  }
  Add-Y2Line $ResFile ("__Y2B_STEP_${Index}__=" + (ConvertTo-Y2Base64 $status))
}

$Steps = @(
__STEP_TABLE__
)
foreach ($s in $Steps) { Invoke-Y2Step $s.Index $s.Name $s.Timeout $s.Body }

Add-Y2Line $ResFile ("__Y2B_DONE__=" + (ConvertTo-Y2Base64 $Y2B_RUN_ID))
exit 0

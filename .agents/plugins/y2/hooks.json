{
  "y2-guards": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/protect_handoff.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "run_command|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/lab_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

